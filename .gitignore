# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets never belong in the repo. Convex deployment vars are set with
# `npx convex env set`; Vite build vars are set on the host.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# generated dictionary data
shared/data/words.jsonl

.agents/
# Only the hand-written contributor tooling is tracked. The vendored convex
# skills are generated from the tracked skills-lock.json by
# `npx convex ai-files install`, so committing them would only add merge
# conflicts on every update.
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/contributing/
.cursor/
.fallow/
