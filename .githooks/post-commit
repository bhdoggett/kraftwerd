#!/usr/bin/env bash
#
# Bring the GitNexus index up to date after every commit, in the background.
#
# The index is what the agents read the code through, and it goes stale with
# every commit: the Claude Code hook only notices and says so, and the
# refresh it asks for was being run by hand. Here it just happens.
#
# Only on the owner's machine. GitNexus is a personal tool here -- `.gitnexus/`
# is excluded locally, not checked in -- so anyone else committing has neither
# the runner nor any use for it, and this hook does nothing for them.
#
# Detached, so the commit never waits on it: an analyze takes about a minute.
# One at a time: a rebase commits in quick succession, and a commit that lands
# while a refresh is running skips its own. The index can then sit a commit
# behind until the next one, which the stale-index notice still reports.
#
# --skip-agents-md: analyze otherwise writes its rules into AGENTS.md and
# CLAUDE.md, which are checked in and would hand them to contributors who do
# not have GitNexus. The owner's copy lives in CLAUDE.local.md instead.
set -uo pipefail

[ "$(git config user.email)" = "bdoggett@gmail.com" ] || exit 0
[ -f .gitnexus/run.cjs ] || exit 0

lock=.gitnexus/.post-commit.lock

# A lock left by a refresh that died rather than finished: no analyze runs
# for ten minutes, so anything older is not one that is still going.
if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10)" ]; then
  rmdir "$lock" 2>/dev/null
fi

# mkdir is atomic: whichever commit makes the directory runs the refresh.
mkdir "$lock" 2>/dev/null || exit 0

(
  trap 'rmdir "$lock" 2>/dev/null' EXIT
  node .gitnexus/run.cjs analyze --index-only --skip-agents-md >.gitnexus/post-commit.log 2>&1
) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null

exit 0
