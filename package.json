{
  "name": "word-craft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite --open'",
    "predev": "convex init && node setup.mjs --once",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "seed:dictionary": "convex import --table words --replace shared/data/words.jsonl"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "~1.6.15",
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wordlist-english": "^1.2.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.55",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
